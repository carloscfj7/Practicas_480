{
    "name": "practicas_480/api_consultorias",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable" : true,
    "repositories": [
        { "type": "vcs", "url": "git@bitbucket.org:practicas_480/api_consultorias.git" }
    ],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "babdev/pagerfanta-bundle": "3.7.0",
        "beberlei/doctrineextensions": "1.3.0",
        "composer/package-versions-deprecated": "1.11.99.5",
        "doctrine/doctrine-bundle": "2.8.2",
        "doctrine/doctrine-fixtures-bundle": "3.4.2",
        "doctrine/doctrine-migrations-bundle": "3.2.2",
        "doctrine/orm": "2.15.5",
        "friendsofsymfony/user-bundle": "3.1.0",
        "gedmo/doctrine-extensions": "3.9.0",
        "gesdinet/jwt-refresh-token-bundle": "1.1.1",
        "knplabs/doctrine-behaviors": "2.6.2",
        "lexik/jwt-authentication-bundle": "^2.21",
        "nelmio/api-doc-bundle": "^5.0",
        "nelmio/cors-bundle": "2.2.0",
        "pagerfanta/doctrine-orm-adapter": "3.7.0",
        "phpstan/phpdoc-parser": "^1.7",
        "psr/log": "^3.0",
        "ramsey/uuid-doctrine": "*",
        "stof/doctrine-extensions-bundle": "1.7.1",
        "symfony/asset": "6.4.7",
        "symfony/cache": "6.4.7",
        "symfony/config": "6.4.7",
        "symfony/console": "6.4.7",
        "symfony/dependency-injection": "6.4.7",
        "symfony/doctrine-bridge": "6.4.7",
        "symfony/dom-crawler": "6.4.7",
        "symfony/dotenv": "6.4.7",
        "symfony/error-handler": "6.4.7",
        "symfony/event-dispatcher": "6.4.7",
        "symfony/filesystem": "6.4.7",
        "symfony/finder": "6.4.7",
        "symfony/flex": "2.2.4",
        "symfony/form": "6.4.7",
        "symfony/framework-bundle": "6.4.7",
        "symfony/http-client": "6.4.15",
        "symfony/http-foundation": "6.4.14",
        "symfony/http-kernel": "6.4.7",
        "symfony/intl": "6.4.7",
        "symfony/mailer": "6.4.7",
        "symfony/mime": "6.4.7",
        "symfony/monolog-bridge": "6.4.7",
        "symfony/monolog-bundle": "3.8.0",
        "symfony/options-resolver": "6.4.7",
        "symfony/password-hasher": "6.4.7",
        "symfony/polyfill-uuid": "1.27.0",
        "symfony/property-access": "6.4.7",
        "symfony/property-info": "6.4.*",
        "symfony/routing": "6.4.7",
        "symfony/security-bundle": "6.4.10",
        "symfony/security-core": "6.4.7",
        "symfony/security-csrf": "6.4.7",
        "symfony/security-http": "6.4.15",
        "symfony/sendgrid-mailer": "6.4.7",
        "symfony/string": "6.4.7",
        "symfony/translation": "6.4.7",
        "symfony/twig-bridge": "6.4.7",
        "symfony/twig-bundle": "6.4.7",
        "symfony/uid": "6.4.7",
        "symfony/validator": "6.4.11",
        "symfony/var-exporter": "6.4.7",
        "symfony/yaml": "6.4.7",
        "thecodingmachine/safe": "2.1"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
        ,
        "codeception/codeception": "^5.2",
        "codeception/module-asserts": "^3.0",
        "codeception/module-doctrine": "^3.1",
        "codeception/module-phpbrowser": "^3.0",
        "codeception/module-rest": "^3.4",
        "codeception/module-symfony": "^3.5",
        "fakerphp/faker": "1.19",
        "phpunit/phpunit": "10.1.2",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "6.4.*",
        "symfony/debug-bundle": "6.4.*",
        "symfony/maker-bundle": "^1.11",
        "symfony/phpunit-bridge": "6.4.*",
        "symfony/stopwatch": "6.4.*",
        "symfony/web-profiler-bundle": "6.4.*"
    }
}
