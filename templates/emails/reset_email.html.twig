{% extends 'emails/base_email.html.twig' %}

{% block content %}
    <p style="white-space: pre-line; margin: 0;font-size: 14px;line-height: 21px;text-align: center">
        {{ 'TR_HELLO_EMAIL' | trans }} <strong>{{ username }}</strong>!<br/>{{ 'TR_RESET_PASSWORD_TEXT' | trans }}
    </p>
    <div align="center" style="padding:25px 10px 10px">
        <div>
            <a href="{{ confirmationUrl }}" style="background-color:#555;border-radius:4px;color:#ffffff;display:inline-block;font-family:'Montserrat','Trebuchet MS','Lucida Grande','Lucida Sans Unicode','Lucida Sans',Tahoma,sans-serif;font-size:16px;line-height:46px;text-align:center;text-decoration:none;width:202px">
                {{ 'TR_RESET_PASSWORD_BUTTON' | trans }}
            </a>
        </div>
    </div>
{% endblock %}